{
  "name": "@apwide/golive-github-actions",
  "version": "1.8.0",
  "description": "Apwide Golive Github Actions",
  "author": "Apwide",
  "license": "MIT",
  "keywords": [
    "github",
    "action",
    "golive",
    "apwide"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "scripts": {
    "test": "vitest",
    "openapi-ts": "openapi-ts",
    "clean": "rimraf dist/",
    "build": "npx ncc build src/index.ts -o dist",
    "lint": "npx eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@hey-api/openapi-ts": "0.85.1",
    "@octokit/types": "15.0.0",
    "@types/node": "20.19.19",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "@vercel/ncc": "0.38.4",
    "dotenv": "17.2.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-standard": "5.0.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "@octokit/plugin-rest-endpoint-methods": "16.1.0"
  }
}
