{
  "name": "@apwide/golive-github-actions",
  "version": "2.8.0",
  "description": "Apwide Golive Github Actions",
  "author": "Apwide",
  "license": "MIT",
  "keywords": [
    "github",
    "action",
    "golive",
    "apwide"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/apwide/golive-github-actions.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "scripts": {
    "test": "vitest",
    "openapi-ts": "openapi-ts",
    "clean": "rimraf dist/",
    "build": "tsup",
    "lint": "npx eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@octokit/types": "18.0.0",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vercel/ncc": "0.45.0",
    "dotenv": "18.0.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-standard": "5.0.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/plugin-rest-endpoint-methods": "18.0.0",
    "js-yaml": "^5.4.3"
  },
  "overrides": {
    "undici": "6.28.1"
  }
}
